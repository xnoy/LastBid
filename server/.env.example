# ---------------------------------------------------------------------------
# BidNova server environment. Copy to `.env` and fill in.
# Never commit the real .env. Nothing in here is ever shipped to the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://bidnova:bidnova@localhost:5432/bidnova?schema=public

# Redis - holds live auction state and runs the atomic bid Lua scripts.
REDIS_URL=redis://localhost:6379

# Auth. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Auctions
# Seconds added to the clock when a bid lands in the final moments (anti-sniping).
ANTI_SNIPE_WINDOW_SECONDS=60
ANTI_SNIPE_EXTENSION_SECONDS=60
# How often the closer job scans for expired auctions.
AUCTION_CLOSER_INTERVAL_MS=2000

# Rate limiting (per user, sliding window, enforced in Redis)
BID_RATE_LIMIT_POINTS=12
BID_RATE_LIMIT_WINDOW_SECONDS=10

# ---------------------------------------------------------------------------
# Optional integrations. All of these are OFF by default and the app runs
# fully without them. See README "Connecting real services".
# ---------------------------------------------------------------------------

# Price predictor. Leave PRICE_ESTIMATOR_PROVIDER=heuristic to use the built-in
# comparable-sales statistics. Set to "http" to call your own model endpoint.
PRICE_ESTIMATOR_PROVIDER=heuristic
PRICE_ESTIMATOR_URL=
PRICE_ESTIMATOR_API_KEY=

# Live streaming (BidTok Live). "mock" renders the studio UI with no video
# transport. Swap for your provider (Mux, LiveKit, IVS, Agora...) in
# src/services/streaming/.
STREAM_PROVIDER=mock
STREAM_API_KEY=
STREAM_API_SECRET=

# Payments. "mock" moves orders through the tracking states without charging.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
